# ---- AMBIENTES VIRTUAIS E SEGREDOS ----
.env
**/.env
!**/.env.example
.venv/
env/
venv/

# ---- FERRAMENTAS DE DESENVOLVIMENTO ----
.cache/
.pre-commit/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- PYTHON: CACHES E ARTEFATOS DE BUILD ----
*$py.class
*.egg-info/
*.py[cod]
__pycache__/
build/
dist/

# ---- LOGS ----
*.log

# ---- NODE / NPM / HUSKY (ARTEFATOS LOCAIS) ----
.husky/
node_modules/
npm-debug.log*
package-lock.json
package.json
yarn-debug.log*
yarn-error.log*

# ---- IA E FERRAMENTAS DE AGENTES (CURSOR/MCP) ----
.agent/
.agents/
.antigravity/
.cursor/
.gemini/

# ---- IDEs E SISTEMA OPERACIONAL ----
*.swp
*.swo
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
desktop.ini
Thumbs.db

# ---- TERRAFORM ----
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/terraform.tfvars
!infra/terraform/**/terraform.tfvars.example

# ---- SERVIDOR MINECRAFT: DADOS PERSISTENTES E BINARIOS ----
app/src/domain/world-data/*
!app/src/domain/world-data/.gitkeep
app/src/domain/world-data/**/session.lock
app/src/domain/world-data/**/level.dat
app/src/domain/world-data/**/level.dat_old
app/src/domain/world-data/**/*.mca
app/src/domain/world-data/**/*.dat

app/src/interface/mods/*.jar
!app/src/interface/mods/mods-manifest.json

app/src/interface/plugins/*.jar

app/src/infrastructure/logging/*
!app/src/infrastructure/logging/.gitkeep

app/src/infrastructure/database/*
!app/src/infrastructure/database/.gitkeep

.azure-setup-tmp/
