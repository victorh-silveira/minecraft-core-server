# ---- DEFINICOES GLOBAIS DO SERVIDOR ----
MINECRAFT_VERSION=<INSIRA A SUA VERSAO DO MINECRAFT DESEJADA>
SERVER_TYPE=<INSIRA O TIPO DO SERVIDOR, EX: FABRIC>
MEMORY_LIMIT=<INSIRA O LIMITE DE MEMORIA, EX: 4G>
EULA_ACCEPTED=<INSIRA TRUE PARA ACEITAR O EULA>

# ---- PORTAS DE REDE ----
GAME_PORT=<INSIRA A PORTA DO JOGO, EX: 25565>
RCON_PORT=<INSIRA A PORTA RCON, EX: 25575>

# ---- CONFIGURACOES INTERNAS DO JOGO ----
ONLINE_MODE=<INSIRA false PARA MODO HIBRIDO OU true PARA MOJANG>
DIFFICULTY=<INSIRA A DIFICULDADE, EX: hard>
MAX_PLAYERS=<INSIRA O NUMERO MAXIMO DE JOGADORES>

# ---- SEGREDOS (NAO VERSIONAR .env) ----
RCON_PASSWORD=<INSIRA UMA SENHA RCON SEGURA>

# ---- PERMISSOES DO CONTAINER (UID/GID) ----
UID=1000
GID=1000
SKIP_CHOWN=false

# ---- DOCKER BUILD E RUNTIME ----
DOCKER_BASE_IMAGE=itzg/minecraft-server:latest
IMAGE_VERSION=0.1.0
DOCKER_PIDS_LIMIT=512
MEMORY_RESERVATION=1G
